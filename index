<!DOCTYPE html>
<html lang="es" class="h-full">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Simulador de Biomecánica Ósea Respiratoria - Vista Transversal (Corte Axial Realista)</title>
  
  <!-- Tailwind CSS CDN -->
  <script src="https://cdn.tailwindcss.com"></script>
  <!-- FontAwesome Icons CDN -->
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
  <!-- Google Fonts: Inter -->
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">

  <script>
    tailwind.config = {
      darkMode: 'class',
      theme: {
        extend: {
          fontFamily: {
            sans: ['Inter', 'sans-serif'],
          }
        }
      }
    }
  </script>

  <style>
    ::-webkit-scrollbar { width: 6px; height: 6px; }
    ::-webkit-scrollbar-track { background: #060b13; }
    ::-webkit-scrollbar-thumb { background: #1e293b; border-radius: 3px; }
    ::-webkit-scrollbar-thumb:hover { background: #334155; }

    canvas { display: block; }

    .option-card {
      transition: all 0.25s cubic-bezier(0.4, 0, 0.2, 1);
    }
    .option-card:hover {
      border-color: rgba(6, 182, 212, 0.5);
      background-color: rgba(15, 23, 42, 0.85);
    }
    .option-card-selected {
      border-color: #06b6d4 !important;
      background-color: rgba(6, 182, 212, 0.12) !important;
      box-shadow: 0 0 20px -5px rgba(6, 182, 212, 0.3);
    }
  </style>
</head>

<body class="h-full bg-slate-950 text-slate-100 font-sans flex flex-col overflow-x-hidden antialiased selection:bg-cyan-500 selection:text-slate-950">

  <header class="bg-slate-900/90 backdrop-blur border-b border-slate-800 sticky top-0 z-50 px-4 py-3">
    <div class="max-w-7xl mx-auto flex flex-col sm:flex-row items-center justify-between gap-3">
      
      <div class="flex items-center gap-3">
        <div class="w-10 h-10 rounded-xl bg-cyan-500/10 border border-cyan-500/30 flex items-center justify-center text-cyan-400 text-xl font-bold shadow-lg shadow-cyan-500/10">
          <i class="fa-solid fa-bone"></i>
        </div>
        <div>
          <h1 class="text-base font-bold text-slate-100 leading-tight">Biomecánica Ósea Torácica Axial</h1>
          <p class="text-xs text-slate-400">Corte Axial T6-T7 con Pectus Excavatum Realista (Índice de Haller ~3.4)</p>
        </div>
      </div>

      <div class="flex items-center gap-3">
        <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-semibold bg-emerald-500/10 text-emerald-400 border border-emerald-500/30">
          <span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span> Motor Anatómico 60 FPS
        </span>
      </div>

    </div>
  </header>

  <main class="flex-1 max-w-7xl w-full mx-auto p-4 sm:p-6 grid grid-cols-1 lg:grid-cols-12 gap-6">
    
    <!-- LEFT COLUMN: Canvas Axial Visualizer & Spirogram -->
    <div class="lg:col-span-7 flex flex-col gap-5">
      
      <!-- MAIN CANVAS BOX -->
      <div class="bg-slate-900 border border-slate-800 rounded-2xl p-4 sm:p-5 flex flex-col relative shadow-2xl">
        <div class="flex items-center justify-between mb-3">
          <div class="flex items-center gap-2">
            <i class="fa-solid fa-crosshairs text-cyan-400"></i>
            <h2 class="text-xs font-bold tracking-wide text-slate-200 uppercase">Corte Axial Anatómico (Vista Superior T6)</h2>
          </div>
          <span id="txt-phase" class="px-3 py-1 rounded-full text-xs font-mono font-semibold bg-slate-950 text-cyan-300 border border-slate-800 flex items-center gap-2">
            <span class="w-2 h-2 rounded-full bg-cyan-400 animate-ping"></span> INSPIRACIÓN
          </span>
        </div>

        <!-- Canvas Container -->
        <div class="relative w-full h-[380px] bg-slate-950 rounded-xl border border-slate-800 overflow-hidden flex items-center justify-center">
          <canvas id="canvas-axial" width="600" height="380" class="w-full h-full block"></canvas>
          
          <!-- Orientation Overlay -->
          <div class="absolute top-2 left-1/2 -translate-x-1/2 text-[10px] font-mono font-bold text-slate-500 uppercase tracking-widest pointer-events-none">
            ANTERIOR (Esternón)
          </div>
          <div class="absolute bottom-2 left-1/2 -translate-x-1/2 text-[10px] font-mono font-bold text-slate-500 uppercase tracking-widest pointer-events-none">
            POSTERIOR (Columna T6)
          </div>
          <div class="absolute top-1/2 left-2 -translate-y-1/2 -rotate-90 text-[10px] font-mono font-bold text-slate-500 uppercase tracking-widest pointer-events-none">
            IZQUIERDA
          </div>
          <div class="absolute top-1/2 right-2 -translate-y-1/2 rotate-90 text-[10px] font-mono font-bold text-slate-500 uppercase tracking-widest pointer-events-none">
            DERECHA
          </div>
        </div>

        <!-- Controls Bar -->
        <div class="mt-4 grid grid-cols-1 sm:grid-cols-3 gap-3 items-center">
          <button id="btn-toggle-play" onclick="togglePlay()" class="flex items-center justify-center gap-2 bg-cyan-600 hover:bg-cyan-500 text-white font-semibold py-2 px-3 rounded-xl transition text-xs shadow-lg shadow-cyan-600/20">
            <i class="fa-solid fa-pause" id="icon-play"></i> <span id="lbl-play">Pausar</span>
          </button>

          <div class="flex items-center gap-2 bg-slate-950 px-3 py-2 rounded-xl border border-slate-800">
            <span class="text-xs text-slate-400 font-semibold whitespace-nowrap">Esfuerzo:</span>
            <input type="range" id="rng-effort" min="20" max="100" value="80" class="w-full accent-cyan-500 bg-slate-800 h-1.5 rounded-lg" oninput="updateControls()">
            <span id="lbl-effort" class="text-xs font-mono font-bold text-cyan-400 min-w-[28px]">80%</span>
          </div>

          <div class="flex items-center gap-2 bg-slate-950 px-3 py-2 rounded-xl border border-slate-800">
            <span class="text-xs text-slate-400 font-semibold whitespace-nowrap">FR (RPM):</span>
            <input type="range" id="rng-rate" min="8" max="28" value="14" class="w-full accent-cyan-500 bg-slate-800 h-1.5 rounded-lg" oninput="updateControls()">
            <span id="lbl-rate" class="text-xs font-mono font-bold text-cyan-400 min-w-[24px]">14</span>
          </div>
        </div>
      </div>

      <!-- SPIROGRAM CANVAS BOX -->
      <div class="bg-slate-900 border border-slate-800 rounded-2xl p-4 flex flex-col shadow-xl">
        <div class="flex items-center justify-between mb-2">
          <div class="flex items-center gap-2">
            <i class="fa-solid fa-chart-line text-cyan-400"></i>
            <h3 class="text-xs font-bold text-slate-200 uppercase">Espirograma Torácico en Tiempo Real</h3>
          </div>
          <span class="text-xs font-mono text-cyan-400">Vt Estimado: <strong id="lbl-vt" class="text-white">500</strong> mL</span>
        </div>
        <div class="w-full h-28 bg-slate-950 rounded-xl border border-slate-800 relative overflow-hidden">
          <canvas id="canvas-spiro" width="600" height="112" class="w-full h-full block"></canvas>
        </div>
      </div>

    </div>

    <div class="lg:col-span-5 flex flex-col gap-5">
      
      <!-- Condition Selector Card Panel -->
      <div class="bg-slate-900 border border-slate-800 rounded-2xl p-4 sm:p-5 shadow-xl">
        <h2 class="text-xs font-bold uppercase text-slate-200 mb-3 flex items-center gap-2">
          <i class="fa-solid fa-stethoscope text-cyan-400"></i> Condición Estructural Torácica
        </h2>

        <div class="space-y-2.5">
          <!-- Normal Card -->
          <div id="card-normal" onclick="setCondition('normal')" class="option-card option-card-selected p-3 rounded-xl border border-slate-800 bg-slate-950/60 cursor-pointer flex items-start gap-3">
            <input type="radio" name="radio-cond" value="normal" checked class="mt-1 accent-cyan-500 pointer-events-none">
            <div>
              <span class="block text-xs font-bold text-slate-100">1. Caja Torácica Fisiológica</span>
              <span class="block text-[11px] text-slate-400 mt-0.5 leading-relaxed">
                Relación AP/LAT de ~0.67. Expansión armónica del contorno esternal y lateral sin restricciones estructurales.
              </span>
            </div>
          </div>

          <!-- Pectus Excavatum Card -->
          <div id="card-pectus" onclick="setCondition('pectus')" class="option-card p-3 rounded-xl border border-slate-800 bg-slate-950/60 cursor-pointer flex items-start gap-3">
            <input type="radio" name="radio-cond" value="pectus" class="mt-1 accent-cyan-500 pointer-events-none">
            <div>
              <span class="block text-xs font-bold text-amber-400">2. Pectus Excavatum (Anatómicamente Realista)</span>
              <span class="block text-[11px] text-slate-400 mt-0.5 leading-relaxed">
                Depresión posterior esternal del 32% (Índice de Haller ~3.4). Mantiene espacio retroesternal adecuado sin colisionar con la columna T6.
              </span>
            </div>
          </div>

          <!-- Artrogriposis Card -->
          <div id="card-arthro" onclick="setCondition('arthro')" class="option-card p-3 rounded-xl border border-slate-800 bg-slate-950/60 cursor-pointer flex items-start gap-3">
            <input type="radio" name="radio-cond" value="arthro" class="mt-1 accent-cyan-500 pointer-events-none">
            <div>
              <span class="block text-xs font-bold text-red-400">3. Artrogriposis / Anquilosis Torácica</span>
              <span class="block text-[11px] text-slate-400 mt-0.5 leading-relaxed">
                Rigidez articular costovertebral. Bloqueo casi total del pivoteo de las costillas e inmovilidad del contorno axial.
              </span>
            </div>
          </div>
        </div>
      </div>

      <!-- Live Metric Gauges -->
      <div class="bg-slate-900 border border-slate-800 rounded-2xl p-4 sm:p-5 shadow-xl space-y-3.5">
        <h3 class="text-xs font-bold uppercase text-slate-200 flex items-center gap-2">
          <i class="fa-solid fa-ruler-combined text-cyan-400"></i> Métricas Biomecánicas Axiales (T6)
        </h3>

        <!-- Area Calculation -->
        <div class="bg-slate-950 p-3 rounded-xl border border-slate-800 flex items-center justify-between">
          <div>
            <span class="text-[11px] text-slate-400 block font-medium">Área de Sección Transversal</span>
            <span class="text-xs text-slate-500">Superficie interna del anillo torácico</span>
          </div>
          <div class="text-right">
            <strong id="val-area" class="text-lg font-mono text-cyan-400">225.0</strong>
            <span class="text-xs font-mono text-slate-400"> cm²</span>
          </div>
        </div>

        <!-- Metric Bars -->
        <div class="space-y-2.5">
          <div>
            <div class="flex justify-between text-xs mb-1">
              <span class="text-slate-300">Diámetro Anteroposterior (AP)</span>
              <strong id="val-ap" class="text-emerald-400 font-mono">16.5 cm</strong>
            </div>
            <div class="w-full h-2 bg-slate-950 rounded-full overflow-hidden border border-slate-800">
              <div id="bar-ap" class="h-full bg-emerald-500 transition-all duration-150" style="width: 75%;"></div>
            </div>
          </div>

          <div>
            <div class="flex justify-between text-xs mb-1">
              <span class="text-slate-300">Diámetro Transversal / Lateral (LAT)</span>
              <strong id="val-lat" class="text-cyan-400 font-mono">24.5 cm</strong>
            </div>
            <div class="w-full h-2 bg-slate-950 rounded-full overflow-hidden border border-slate-800">
              <div id="bar-lat" class="h-full bg-cyan-500 transition-all duration-150" style="width: 80%;"></div>
            </div>
          </div>

          <div>
            <div class="flex justify-between text-xs mb-1">
              <span class="text-slate-300">Índice Torácico (AP / LAT)</span>
              <strong id="val-ratio" class="text-purple-400 font-mono">0.67</strong>
            </div>
            <div class="w-full h-2 bg-slate-950 rounded-full overflow-hidden border border-slate-800">
              <div id="bar-ratio" class="h-full bg-purple-500 transition-all duration-150" style="width: 67%;"></div>
            </div>
          </div>

          <div>
            <div class="flex justify-between text-xs mb-1">
              <span class="text-slate-300">Índice Tomográfico de Haller (LAT / AP)</span>
              <strong id="val-haller" class="text-amber-400 font-mono">2.50 (Normal)</strong>
            </div>
            <div class="w-full h-2 bg-slate-950 rounded-full overflow-hidden border border-slate-800">
              <div id="bar-haller" class="h-full bg-amber-500 transition-all duration-150" style="width: 45%;"></div>
            </div>
          </div>
        </div>
      </div>

      <!-- Clinical Description -->
      <div class="bg-slate-900 border border-slate-800 rounded-2xl p-4 flex-1 flex flex-col justify-between shadow-xl">
        <div>
          <h3 class="text-xs font-bold uppercase text-slate-200 mb-2 flex items-center gap-2">
            <i class="fa-solid fa-notes-medical text-amber-400"></i> Análisis Anatómico y Clínico
          </h3>
          <p id="txt-clinical" class="text-xs text-slate-300 leading-relaxed"></p>
        </div>
      </div>

    </div>

  </main>

  <script>
    // State Variables
    let condition = 'normal';
    let isPlaying = true;
    let cycleProgress = 0;
    let spiroHistory = [];
    
    // Canvas References
    let axialCanvas, axialCtx;
    let spiroCanvas, spiroCtx;

    const conditionPresets = {
      normal: {
        baseAp: 16.5,
        expandAp: 3.2,
        baseLat: 24.5,
        expandLat: 3.8,
        pectusDepth: 0, // Normal anatomical sternal contour
        rigidity: 1.0,
        vt: 500,
        desc: "<strong>Fisiología Normal:</strong> La sección transversal demuestra una relación anteroposterior a lateral simétrica (Índice de Haller de 2.50). Durante la inspiración, la proyección esternal aumenta el diámetro AP (manivela de bomba) y la expansión de las arcadas costales amplía el diámetro lateral (asa de cubo)."
      },
      pectus: {
        baseAp: 11.2, // ~32% reduction compared to normal 16.5cm
        expandAp: 1.8,
        baseLat: 25.2, // Compensatory slight widening
        expandLat: 3.4,
        pectusDepth: 22, // Realistic anatomical depression (in px), keeping retrosternal gap
        rigidity: 0.85,
        vt: 345,
        desc: "<strong>Pectus Excavatum Realista (Índice de Haller ~3.4):</strong> Muestra una depresión esternal posterior moderada-severa con una concavidad suave de los cartílagos costales. El espacio retroesternal se conserva adecuadamente sin tocar la columna vertebral T6, reproduciendo los hallazgos típicos en tomografía computarizada."
      },
      arthro: {
        baseAp: 15.8,
        expandAp: 0.3,
        baseLat: 23.8,
        expandLat: 0.4,
        pectusDepth: 0,
        rigidity: 0.12, // High rigidity
        vt: 180,
        desc: "<strong>Artrogriposis / Anquilosis Torácica:</strong> Rigidez y fusión de las articulaciones costovertebrales posteriores. El contorno de la caja torácica permanece rígido e inalterado durante la inspiración, restringiendo severamente el volumen corriente."
      }
    };

    window.addEventListener('load', () => {
      axialCanvas = document.getElementById('canvas-axial');
      axialCtx = axialCanvas.getContext('2d');
      
      spiroCanvas = document.getElementById('canvas-spiro');
      spiroCtx = spiroCanvas.getContext('2d');

      updateControls();
      requestAnimationFrame(mainSimulationLoop);
    });

    function togglePlay() {
      isPlaying = !isPlaying;
      document.getElementById('icon-play').className = isPlaying ? "fa-solid fa-pause" : "fa-solid fa-play";
      document.getElementById('lbl-play').textContent = isPlaying ? "Pausar" : "Reanudar";
    }

    function setCondition(condKey) {
      condition = condKey;
      
      ['normal', 'pectus', 'arthro'].forEach(k => {
        const card = document.getElementById(`card-${k}`);
        if (k === condKey) {
          card.classList.add('option-card-selected');
          card.querySelector('input').checked = true;
        } else {
          card.classList.remove('option-card-selected');
        }
      });

      updateControls();
    }

    function updateControls() {
      const effort = parseFloat(document.getElementById('rng-effort').value);
      const rate = parseFloat(document.getElementById('rng-rate').value);
      document.getElementById('lbl-effort').textContent = `${effort}%`;
      document.getElementById('lbl-rate').textContent = `${rate}`;
      document.getElementById('txt-clinical').innerHTML = conditionPresets[condition].desc;
    }

    function mainSimulationLoop() {
      const rate = parseFloat(document.getElementById('rng-rate').value);
      
      if (isPlaying) {
        // Respiratory cycle increment derived from RPM rate
        cycleProgress += (rate / 60) * 0.12;
        if (cycleProgress > Math.PI * 2) cycleProgress -= Math.PI * 2;
      }

      const sinVal = Math.sin(cycleProgress);
      const normSin = (sinVal + 1) / 2; // Range 0..1
      const isInspiration = sinVal > 0;

      // Phase UI Indicator
      const phaseEl = document.getElementById('txt-phase');
      if (isInspiration) {
        phaseEl.innerHTML = `<span class="w-2 h-2 rounded-full bg-cyan-400 animate-ping"></span> INSPIRACIÓN`;
        phaseEl.className = "px-3 py-1 rounded-full text-xs font-mono font-semibold bg-slate-950 text-cyan-300 border border-slate-800 flex items-center gap-2";
      } else {
        phaseEl.innerHTML = `<span class="w-2 h-2 rounded-full bg-slate-500"></span> ESPIRACIÓN`;
        phaseEl.className = "px-3 py-1 rounded-full text-xs font-mono font-semibold bg-slate-950 text-slate-400 border border-slate-800 flex items-center gap-2";
      }

      const preset = conditionPresets[condition];
      const effortMult = (parseFloat(document.getElementById('rng-effort').value) / 100) * preset.rigidity;

      // Realtime Dynamic Biomechanical Calculations
      const currentAp = preset.baseAp + (preset.expandAp * normSin * effortMult);
      const currentLat = preset.baseLat + (preset.expandLat * normSin * effortMult);
      
      // Intrathoracic Area
      const currentArea = (Math.PI * (currentAp / 2) * (currentLat / 2) * 0.86) - (condition === 'pectus' ? 12 : 0);
      const currentRatio = currentAp / currentLat;
      const hallerIndex = currentLat / currentAp;
      const currentVt = Math.round(preset.vt * normSin * (effortMult > 0.25 ? effortMult : 0.25));

      // Update Text Metrics
      document.getElementById('val-area').textContent = currentArea.toFixed(1);
      document.getElementById('val-ap').textContent = `${currentAp.toFixed(1)} cm`;
      document.getElementById('val-lat').textContent = `${currentLat.toFixed(1)} cm`;
      document.getElementById('val-ratio').textContent = currentRatio.toFixed(2);
      
      const hallerEl = document.getElementById('val-haller');
      hallerEl.textContent = `${hallerIndex.toFixed(2)} ${hallerIndex > 3.2 ? '(Pectus Moderado-Severo)' : '(Normal)'}`;
      hallerEl.className = hallerIndex > 3.2 ? 'text-amber-400 font-mono' : 'text-emerald-400 font-mono';

      document.getElementById('lbl-vt').textContent = currentVt;

      // Update Gauges
      document.getElementById('bar-ap').style.width = `${Math.min(100, (currentAp / 22) * 100)}%`;
      document.getElementById('bar-lat').style.width = `${Math.min(100, (currentLat / 30) * 100)}%`;
      document.getElementById('bar-ratio').style.width = `${Math.min(100, (currentRatio / 1.0) * 100)}%`;
      document.getElementById('bar-haller').style.width = `${Math.min(100, (hallerIndex / 5.0) * 100)}%`;

      // Render Canvases
      renderAxialSection(normSin, effortMult, preset, currentAp, currentLat);
      renderSpirogram(currentVt);

      requestAnimationFrame(mainSimulationLoop);
    }

    function renderAxialSection(normSin, effortMult, preset, dynamicAp, dynamicLat) {
      const w = axialCanvas.width;
      const h = axialCanvas.height;
      const cx = w / 2;
      const cy = h / 2 + 10;

      axialCtx.clearRect(0, 0, w, h);

      // Background Grid
      axialCtx.strokeStyle = 'rgba(30, 41, 59, 0.35)';
      axialCtx.lineWidth = 1;
      for (let x = 0; x < w; x += 30) {
        axialCtx.beginPath(); axialCtx.moveTo(x, 0); axialCtx.lineTo(x, h); axialCtx.stroke();
      }
      for (let y = 0; y < h; y += 30) {
        axialCtx.beginPath(); axialCtx.moveTo(0, y); axialCtx.lineTo(w, y); axialCtx.stroke();
      }

      // Radius in pixels
      const radiusX = (dynamicLat / 2) * 8.2;
      const radiusY = (dynamicAp / 2) * 8.2;

      // 1. LUNG PARENCHYMA & PLEURAL SPACE
      const lungGradient = axialCtx.createRadialGradient(cx, cy, 10, cx, cy, radiusX);
      lungGradient.addColorStop(0, 'rgba(14, 165, 233, 0.22)');
      lungGradient.addColorStop(1, 'rgba(3, 105, 161, 0.04)');

      axialCtx.beginPath();
      axialCtx.ellipse(cx, cy, radiusX - 10, radiusY - 10, 0, 0, Math.PI * 2);
      axialCtx.fillStyle = lungGradient;
      axialCtx.fill();

      // 2. VERTEBRAL BODY T6 (POSTERIOR)
      const vertY = cy + radiusY - 10;
      
      axialCtx.fillStyle = '#94a3b8';
      axialCtx.strokeStyle = '#64748b';
      axialCtx.lineWidth = 2;
      axialCtx.beginPath();
      axialCtx.ellipse(cx, vertY, 32, 20, 0, 0, Math.PI * 2);
      axialCtx.fill();
      axialCtx.stroke();

      // Spinal Canal
      axialCtx.fillStyle = '#0f172a';
      axialCtx.beginPath();
      axialCtx.arc(cx, vertY + 10, 8, 0, Math.PI * 2);
      axialCtx.fill();

      // Transverse Processes
      axialCtx.strokeStyle = '#94a3b8';
      axialCtx.lineWidth = 5;
      axialCtx.beginPath();
      axialCtx.moveTo(cx - 30, vertY); axialCtx.lineTo(cx - 52, vertY + 12);
      axialCtx.moveTo(cx + 30, vertY); axialCtx.lineTo(cx + 52, vertY + 12);
      axialCtx.stroke();

      axialCtx.fillStyle = '#64748b';
      axialCtx.font = '10px Inter';
      axialCtx.textAlign = 'center';
      axialCtx.fillText("Vértebra T6", cx, vertY + 3);

      // 3. STERNUM (ANTERIOR BONE) - REALISTIC PECTUS DEPRESSION
      const pectusIndentPx = preset.pectusDepth;
      const sternumY = cy - radiusY + 12 + pectusIndentPx;

      axialCtx.fillStyle = condition === 'pectus' ? '#f59e0b' : '#e2e8f0';
      axialCtx.strokeStyle = '#64748b';
      axialCtx.lineWidth = 2;

      axialCtx.beginPath();
      axialCtx.roundRect(cx - 22, sternumY - 8, 44, 16, 4);
      axialCtx.fill();
      axialCtx.stroke();

      axialCtx.fillStyle = '#0f172a';
      axialCtx.font = 'bold 9px Inter';
      axialCtx.fillText("ESTERNÓN", cx, sternumY + 3);

      // 4. RIB ARCS & COSTAL CARTILAGES
      const ribColor = '#cbd5e1';
      const cartilageColor = '#38bdf8';

      // Left Rib
      axialCtx.beginPath();
      axialCtx.moveTo(cx - 42, vertY + 8);
      axialCtx.bezierCurveTo(
        cx - radiusX - 18, vertY - 20,
        cx - radiusX - 8, sternumY + 35,
        cx - 22, sternumY
      );
      axialCtx.strokeStyle = ribColor;
      axialCtx.lineWidth = 7;
      axialCtx.stroke();

      // Right Rib
      axialCtx.beginPath();
      axialCtx.moveTo(cx + 42, vertY + 8);
      axialCtx.bezierCurveTo(
        cx + radiusX + 18, vertY - 20,
        cx + radiusX + 8, sternumY + 35,
        cx + 22, sternumY
      );
      axialCtx.strokeStyle = ribColor;
      axialCtx.lineWidth = 7;
      axialCtx.stroke();

      // Costal Cartilage
      axialCtx.strokeStyle = cartilageColor;
      axialCtx.lineWidth = 5;
      
      // Left Cartilage
      axialCtx.beginPath();
      axialCtx.moveTo(cx - 65, sternumY + 22);
      axialCtx.lineTo(cx - 22, sternumY);
      axialCtx.stroke();

      // Right Cartilage
      axialCtx.beginPath();
      axialCtx.moveTo(cx + 65, sternumY + 22);
      axialCtx.lineTo(cx + 22, sternumY);
      axialCtx.stroke();

      // 5. EXPANSION VECTORS
      if (isPlaying && normSin > 0.08) {
        axialCtx.strokeStyle = '#06b6d4';
        axialCtx.fillStyle = '#06b6d4';
        axialCtx.lineWidth = 2;

        // AP Arrow
        drawArrow(axialCtx, cx, sternumY - 12, cx, sternumY - 30);
        
        // Lateral Arrows
        drawArrow(axialCtx, cx - radiusX - 8, cy, cx - radiusX - 26, cy);
        drawArrow(axialCtx, cx + radiusX + 8, cy, cx + radiusX + 26, cy);
      }

      // 6. DIMENSION LINES
      // AP Line
      axialCtx.strokeStyle = 'rgba(52, 211, 153, 0.6)';
      axialCtx.lineWidth = 1.5;
      axialCtx.setLineDash([4, 4]);
      axialCtx.beginPath();
      axialCtx.moveTo(cx, sternumY);
      axialCtx.lineTo(cx, vertY);
      axialCtx.stroke();

      // LAT Line
      axialCtx.strokeStyle = 'rgba(56, 189, 248, 0.6)';
      axialCtx.beginPath();
      axialCtx.moveTo(cx - radiusX, cy);
      axialCtx.lineTo(cx + radiusX, cy);
      axialCtx.stroke();
      axialCtx.setLineDash([]);
    }

    function drawArrow(ctx, fromx, fromy, tox, toy) {
      const headlen = 7;
      const dx = tox - fromx;
      const dy = toy - fromy;
      const angle = Math.atan2(dy, dx);
      ctx.beginPath();
      ctx.moveTo(fromx, fromy);
      ctx.lineTo(tox, toy);
      ctx.lineTo(tox - headlen * Math.cos(angle - Math.PI / 6), toy - headlen * Math.sin(angle - Math.PI / 6));
      ctx.moveTo(tox, toy);
      ctx.lineTo(tox - headlen * Math.cos(angle + Math.PI / 6), toy - headlen * Math.sin(angle + Math.PI / 6));
      ctx.stroke();
    }

    function renderSpirogram(vtValue) {
      const w = spiroCanvas.width;
      const h = spiroCanvas.height;

      spiroHistory.push(vtValue);
      if (spiroHistory.length > 220) spiroHistory.shift();

      spiroCtx.clearRect(0, 0, w, h);

      // Baseline
      spiroCtx.strokeStyle = 'rgba(30, 41, 59, 0.5)';
      spiroCtx.lineWidth = 1;
      spiroCtx.beginPath();
      spiroCtx.moveTo(0, h / 2); spiroCtx.lineTo(w, h / 2);
      spiroCtx.stroke();

      // Curve
      spiroCtx.strokeStyle = condition === 'arthro' ? '#f87171' : (condition === 'pectus' ? '#f59e0b' : '#06b6d4');
      spiroCtx.lineWidth = 2.5;
      spiroCtx.beginPath();

      const stepX = w / 220;
      for (let i = 0; i < spiroHistory.length; i++) {
        const x = i * stepX;
        const y = h - 12 - ((spiroHistory[i] / 600) * (h - 24));
        if (i === 0) spiroCtx.moveTo(x, y);
        else spiroCtx.lineTo(x, y);
      }
      spiroCtx.stroke();
    }
  </script>

